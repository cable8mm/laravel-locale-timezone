{
    "name": "cable8mm/laravel-locale-timezone",
    "description": "Per-request locale and timezone context for Laravel: Accept-Language and X-Timezone headers, scoped container binding, request macros and sane fallbacks.",
    "keywords": [
        "laravel",
        "locale",
        "timezone",
        "localization",
        "i18n"
    ],
    "license": "MIT",
    "homepage": "https://github.com/cable8mm/laravel-locale-timezone",
    "support": {
        "issues": "https://github.com/cable8mm/laravel-locale-timezone/issues",
        "source": "https://github.com/cable8mm/laravel-locale-timezone"
    },
    "authors": [
        {
            "name": "Samgu Lee",
            "email": "cable8mm@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Cable8mm\\LocaleTimezone\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cable8mm\\LocaleTimezone\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "./vendor/bin/phpunit tests"
        ],
        "lint": [
            "./vendor/bin/pint"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cable8mm\\LocaleTimezone\\LocaleTimezoneServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
